FROM node:22-alpine
WORKDIR /app/web
COPY web/asset-preview-proxy.mjs ./
COPY web/lib/request-events.mjs ./lib/
COPY web/lib/bundle-export-rows.mjs ./lib/
COPY web/templates ./templates/
ENV PACK_QA_API_ONLY=1 PACK_QA_HOST=0.0.0.0 PORT=3003 PACK_QA_DATA_DIR=/data
RUN mkdir /data && chown node:node /data
USER node
VOLUME /data
EXPOSE 3003
CMD ["node", "asset-preview-proxy.mjs"]
